<div class="pc-calon <%= c.status === 'diperaku' ? 'is-diperaku' : '' %>">
  <div>
    <% if (c.gambar) { %>
      <img class="pc-photo" src="<%= c.gambar %>" alt="Gambar <%= c.nama %>" loading="lazy">
    <% } else { %>
      <div class="pc-photo-placeholder"><%= (c.nama || '?').trim().charAt(0) %></div>
    <% } %>
  </div>

  <div class="pc-calon-body">
    <div class="pc-calon-head">
      <div>
        <div class="pc-calon-name"><%= c.nama %></div>
      </div>
      <% if (c.status === 'diperaku') { %>
        <span class="pc-status ok">DIPERAKU</span>
      <% } else { %>
        <span class="pc-status pending">BELUM DIPERAKU</span>
      <% } %>
    </div>
    <div class="pc-calon-jawatan"><%= c.jawatan %></div>

    <div class="pc-fields">
      <div class="pc-field"><div class="k">Kod</div><div class="v"><%= c.kod %></div></div>
      <div class="pc-field"><div class="k">No. Kad Pengenalan</div><div class="v"><%= c.noKadPengenalan %></div></div>
      <div class="pc-field"><div class="k">Umur</div><div class="v"><%= c.umur || '-' %></div></div>
      <div class="pc-field"><div class="k">Gred Gaji</div><div class="v"><%= c.gredGaji || '-' %></div></div>
      <div class="pc-field"><div class="k">Skim Perkhidmatan</div><div class="v"><%= c.skim || '-' %></div></div>
      <div class="pc-field"><div class="k">Anugerah</div><div class="v"><%= c.anugerah %></div></div>
      <div class="pc-field"><div class="k">Kategori Pencalonan</div><div class="v"><%= c.kategori %></div></div>
      <div class="pc-field"><div class="k">Tempoh Lantikan Pertama</div><div class="v"><%= c.tempohLantikanPertama || '-' %></div></div>
      <div class="pc-field"><div class="k">Tempoh Lantikan Sekarang</div><div class="v"><%= c.tempohLantikanSekarang || '-' %></div></div>
      <div class="pc-field"><div class="k">Bangsa</div><div class="v"><%= c.bangsa || 'Belum dinyatakan' %></div></div>
    </div>

    <% var parsed = parseAnugerah(c.anugerahDiterima); %>
    <div class="pc-notes-label">Anugerah Yang Diterima</div>
    <div class="pc-notes">
      <% if (parsed.anugerah.length === 0) { %>
        <div class="pc-note-item"><span class="pc-note-thn"></span><span class="pc-note-teks">Tiada</span></div>
      <% } %>
      <% parsed.anugerah.forEach(function(e) { %>
        <div class="pc-note-item"><span class="pc-note-thn"><%= e.tahun %></span><span class="pc-note-teks"><%= e.teks %></span></div>
      <% }) %>
    </div>
    <% if (parsed.nota.length) { %>
      <div class="pc-notes-label" style="margin-top:10px;">Nota / Sumbangan</div>
      <div class="pc-notes">
        <% parsed.nota.forEach(function(e) { %>
          <div class="pc-note-item"><span class="pc-note-thn"><%= e.tahun %></span><span class="pc-note-teks"><%= e.teks %></span></div>
        <% }) %>
      </div>
    <% } %>

    <div class="pc-peraku-bar">
      <% if (c.status === 'diperaku') { %>
        <div class="pc-diperaku-box">
          <span>&#10004; Diperaku oleh <strong><%= c.diperakuOleh || '-' %></strong><%= c.tarikhPeraku ? ' &middot; ' + new Date(c.tarikhPeraku).toLocaleDateString('ms-MY') : '' %></span>
          <form action="/pencalonan/<%= c.id %>/batal-peraku" method="post"
                onsubmit="return confirm('Batalkan peraku bagi calon ini?');">
            <input type="hidden" name="kembali" value="<%= typeof kembali !== 'undefined' ? kembali : '/pencalonan/diperaku' %>">
            <button type="submit" class="pc-btn-batal">Batal Peraku</button>
          </form>
        </div>
      <% } else { %>
        <form action="/pencalonan/<%= c.id %>/peraku" method="post" class="pc-peraku-box">
          <input type="hidden" name="kembali" value="<%= typeof kembali !== 'undefined' ? kembali : '/pencalonan/senarai' %>">
          <input type="text" name="diperakuOleh" placeholder="Nama peraku (pilihan)">
          <button type="submit" class="pc-btn-peraku">PERAKU</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
