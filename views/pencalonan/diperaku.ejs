<%- include('../partials/header', { title: title }) %>

<h3 class="mb-1">Senarai Calon Diperaku</h3>
<p class="text-muted">Calon yang telah diperaku, disusun mengikut kementerian/jabatan.</p>

<form class="row g-2 mb-3" method="get" action="/pencalonan/diperaku">
  <div class="col-md-3">
    <input type="text" class="form-control" name="q" placeholder="Cari nama / No. KP / jawatan" value="<%= filters.q %>">
  </div>
  <div class="col-md-3">
    <select class="form-select" name="kementerian">
      <option value="">Semua Kementerian/Jabatan</option>
      <% kementerianList.forEach(function(k) { %>
        <option value="<%= k %>" <%= filters.kementerian === k ? 'selected' : '' %>><%= k %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2">
    <select class="form-select" name="kategoriPencalonan">
      <option value="">Semua Kategori</option>
      <% kategoriList.forEach(function(k) { %>
        <option value="<%= k %>" <%= filters.kategoriPencalonan === k ? 'selected' : '' %>><%= k %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2">
    <select class="form-select" name="anugerah">
      <option value="">Semua Anugerah</option>
      <% anugerahList.forEach(function(a) { %>
        <option value="<%= a %>" <%= filters.anugerah === a ? 'selected' : '' %>><%= a %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-2 d-flex gap-2">
    <button type="submit" class="btn btn-primary flex-fill">Tapis</button>
    <a href="/pencalonan/diperaku" class="btn btn-outline-secondary">Reset</a>
  </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted"><%= jumlah %> calon telah diperaku</span>
</div>

<% if (groups.length === 0) { %>
  <p class="text-center text-muted">Tiada calon diperaku setakat ini.</p>
<% } %>

<% groups.forEach(function(group) { %>
  <div class="card mb-3">
    <div class="card-header bg-success text-white d-flex justify-content-between">
      <span><%= group.kementerian %></span>
      <span class="badge bg-light text-dark"><%= group.calon.length %> calon</span>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Nama</th>
            <th>No. KP</th>
            <th>Jawatan</th>
            <th>Anugerah</th>
            <th>Diperaku Oleh</th>
            <th>Tarikh Peraku</th>
            <th>Tindakan</th>
          </tr>
        </thead>
        <tbody>
          <% group.calon.forEach(function(c) { %>
            <tr>
              <td><a href="/pencalonan/<%= c.id %>"><%= c.nama %></a></td>
              <td><%= c.noKadPengenalan %></td>
              <td><%= c.jawatan %></td>
              <td><%= c.anugerah %></td>
              <td><%= c.diperakuOleh || '-' %></td>
              <td><%= c.tarikhPeraku ? new Date(c.tarikhPeraku).toLocaleString('ms-MY') : '-' %></td>
              <td><a href="/pencalonan/<%= c.id %>" class="btn btn-sm btn-outline-primary">Lihat</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% }) %>

<%- include('../partials/footer') %>
