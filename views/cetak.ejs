<!doctype html>
<html lang="ms">
<head>
  <meta charset="utf-8">
  <title>Laporan Penerima - Sistem Laporan DKBPP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @media print {
      .no-print { display: none; }
    }
    body { padding: 2rem; }
  </style>
</head>
<body>
  <div class="no-print mb-3 text-end">
    <button class="btn btn-primary" onclick="window.print()">Cetak / Simpan sebagai PDF</button>
  </div>

  <div class="text-center mb-4">
    <h4 class="mb-0">LAPORAN PENERIMA</h4>
    <h5>Darjah Kebesaran, Bintang dan Pingat Persekutuan</h5>
    <p class="text-muted">Dijana pada <%= tarikh.toLocaleDateString('ms-MY') %></p>
  </div>

  <table class="table table-bordered table-sm">
    <thead>
      <tr>
        <th>#</th>
        <th>Nama</th>
        <th>No. KP</th>
        <th>Jenis Anugerah</th>
        <th>Gelaran/Pangkat</th>
        <th>Tahun</th>
        <th>Negeri/Institusi</th>
      </tr>
    </thead>
    <tbody>
      <% if (records.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted">Tiada rekod.</td></tr>
      <% } %>
      <% records.forEach(function(r, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= r.nama %></td>
          <td><%= r.noKp %></td>
          <td><%= r.jenisAnugerah %></td>
          <td><%= r.gelaran %></td>
          <td><%= r.tahun %></td>
          <td><%= r.negeriInstitusi %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <p class="mt-4">Jumlah rekod: <%= records.length %></p>
</body>
</html>
